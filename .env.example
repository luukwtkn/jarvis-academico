# ============================================================
#  JARVIS Acadêmico – Configurações de ambiente
#  Renomeie este arquivo para .env e preencha os valores
# ============================================================

# Token fornecido pelo professor para acessar o Gemma 12B
GEMMA_API_KEY=seu_token_aqui

# URL base da API (ajuste conforme o endpoint do professor)
GEMMA_BASE_URL=https://api.example.com/v1

# Nome exato do modelo disponível
GEMMA_MODEL=gemma-12b

# Pasta onde ficam os PDFs/textos para o RAG
DOCS_PATH=./docs

# Arquivo de agenda
AGENDA_FILE=./data/agenda.json

# Arquivo de tarefas
TASKS_FILE=./data/tasks.json

# Arquivo do índice vetorial (gerado automaticamente)
INDEX_PATH=./data/faiss_index
